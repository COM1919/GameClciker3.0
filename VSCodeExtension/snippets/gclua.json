{
  "GC 脚本模板": {
    "prefix": "gctemplate",
    "body": [
      "-- GC Lua 脚本模板",
      "local enable = false",
      "",
      "function initScript()",
      "    SetScriptLoopDelay(${1:10})",
      "end",
      "",
      "function main()",
      "    ${2}",
      "end",
      "",
      "function render()",
      "    $0",
      "end",
      "",
      "function saveConfig()",
      "end"
    ],
    "description": "插入一个完整的 GC Lua 脚本骨架"
  },
  "initScript 初始化": {
    "prefix": "gcinit",
    "body": [
      "function initScript()",
      "    SetScriptLoopDelay(${1:10})",
      "    ${2}",
      "end"
    ],
    "description": "脚本初始化函数"
  },
  "main 主循环": {
    "prefix": "gcmain",
    "body": [
      "function main()",
      "    ${1}",
      "end"
    ],
    "description": "脚本主循环函数"
  },
  "render 设置界面": {
    "prefix": "gcrender",
    "body": [
      "function render()",
      "    ${1}",
      "end"
    ],
    "description": "脚本设置界面渲染函数"
  },
  "saveConfig 保存配置": {
    "prefix": "gcsave",
    "body": [
      "function saveConfig()",
      "    ${1}",
      "end"
    ],
    "description": "保存配置函数"
  },
  "按键点击检测": {
    "prefix": "gckeyclick",
    "body": [
      "if GetKeyClick(KEY.${1:SPACE}) then",
      "    ${2}",
      "end"
    ],
    "description": "检测某个按键是否被点击"
  },
  "模拟按键点击": {
    "prefix": "gcsetkey",
    "body": "SetKeyClick(KEY.${1:SPACE}, SC.${2:SEND_INPUT}, ${3:50})",
    "description": "模拟点击某个按键"
  },
  "日志输出": {
    "prefix": "gclog",
    "body": "PrintLog(\"[${1:脚本名}]${2:内容}\", ${3:1})",
    "description": "输出日志"
  },
  "弹出提示": {
    "prefix": "gctip",
    "body": "RenderPopTip(\"${1:提示内容}\", ${2:2}, ${3:1})",
    "description": "显示弹出提示"
  },
  "消息框": {
    "prefix": "gcmsgbox",
    "body": [
      "if RenderMessageBox(\"${1:消息}\", \"${2:标题}\", ${3:0}) == 1 then",
      "    ${4}",
      "end"
    ],
    "description": "显示阻塞式消息框"
  },
  "整数滑块": {
    "prefix": "gcslider",
    "body": "${1:value} = SliderInt(\"${2:标签}####${3:id}\", ${1:value}, ${4:0}, ${5:100}, \"%d\")",
    "description": "创建一个整数滑块"
  },
  "复选框": {
    "prefix": "gccheckbox",
    "body": "${1:value} = Checkbox(\"${2:标签}####${3:id}\", ${1:value})",
    "description": "创建复选框"
  },
  "下拉框": {
    "prefix": "gccombo",
    "body": "${1:select} = Combo(\"${2:标签}####${3:id}\", ${1:select}, {${4:\"选项一\", \"选项二\"}})",
    "description": "创建下拉框"
  },
  "网络连接": {
    "prefix": "gcnetwork",
    "body": [
      "local id = ConnectNetwork(\"${1:127.0.0.1}\", ${2:8080})",
      "if id ~= -1 then",
      "    SendNetwork(id, \"${3:hello}\")",
      "    local msg = RecvNetwork(id)",
      "    CloseNetwork(id)",
      "end"
    ],
    "description": "连接 TCP 服务器并收发数据（需网络授权）"
  },
  "读取聊天消息": {
    "prefix": "gcchat",
    "body": [
      "local msg = minecraft.chat.GetNewMsg()",
      "while msg ~= nil do",
      "    PrintLog(\"[${1:脚本名}] \" .. msg, 1)",
      "    msg = minecraft.chat.GetNewMsg()",
      "end"
    ],
    "description": "循环读取新的聊天消息"
  },
  "if-else 完整结构": {
    "prefix": "gcifelse",
    "body": [
      "if ${1:condition} then",
      "    ${2}",
      "else",
      "    ${3}",
      "end"
    ],
    "description": "if-else 完整结构（自动配 end）"
  },
  "if-elseif-else 完整结构": {
    "prefix": "gcifelseif",
    "body": [
      "if ${1:condition1} then",
      "    ${2}",
      "elseif ${3:condition2} then",
      "    ${4}",
      "else",
      "    ${5}",
      "end"
    ],
    "description": "if-elseif-else 完整结构（自动配 end）"
  },
  "do 块": {
    "prefix": "gcdo",
    "body": [
      "do",
      "    ${1}",
      "end"
    ],
    "description": "do 块（自动配 end）"
  },
  "local 变量声明": {
    "prefix": "gclocal",
    "body": "local ${1:name} = ${2:value}",
    "description": "声明一个局部变量"
  },
  "while 循环": {
    "prefix": "gcwhile",
    "body": [
      "while ${1:condition} do",
      "    ${2}",
      "end"
    ],
    "description": "while 循环（自动配 end）"
  },
  "for 数值循环": {
    "prefix": "gcfor",
    "body": [
      "for ${1:i} = ${2:1}, ${3:10} do",
      "    ${4}",
      "end"
    ],
    "description": "数值 for 循环（自动配 end）"
  },
  "for 遍历循环": {
    "prefix": "gcforin",
    "body": [
      "for ${1:k}, ${2:v} in pairs(${3:table}) do",
      "    ${4}",
      "end"
    ],
    "description": "遍历 for 循环（自动配 end）"
  }
}